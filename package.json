{
  "name": "dca-autonomous-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx src/index.ts",
    "dev:api": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "serve:dist": "npm run build && node dist/index.js",
    "debug:start": "env | grep -E 'RPC_URL|ZERO_DEV|PIMLICO|DELEGATE|NO_API' || true; node -e 'console.log(\"[preflight] node version\", process.version)'; tsx src/index.ts",
    "api:start": "bash ./api-start.sh",
    "api:stop": "bash ./api-stop.sh",
    "dca:once": "tsx src/index.ts --once",
    "verify:audit": "tsx src/verify-audit.ts",
    "audit:migrate:dry": "tsx src/migrate-audit-chain.ts --dry",
    "audit:migrate": "tsx src/migrate-audit-chain.ts && npm run verify:audit",
    "replay:decision": "tsx src/replay-decision.ts",
  "test:determinism": "tsx src/test-determinism.ts",
    "verify:latest": "tsx src/verify-latest-decision.ts",
    "verify:hyperindex": "tsx src/verify-hyperindex.ts",
  "verify:hyperindex:proof": "tsx src/verify-hyperindex-proof.ts",
  "simulate:hyperindex:anomaly": "tsx src/simulate-hyperindex-anomaly.ts",
  "simulate:auto-revoke": "tsx src/simulate-auto-revoke.ts",
  "verify:proof-pack": "tsx src/verify-proof-pack.ts",
    "build:proof-pack": "tsx src/build-proof-pack.ts",
    "verify:guardrails": "tsx src/verify-guardrails.ts",
  "verify:guardrails-config": "tsx src/verify-guardrails-config.ts",
    "verify:live": "tsx src/verify-live.ts",
    "verify:all": "tsx src/verify-all.ts",
  "abi:blockvision": "tsx src/tools/fetch-abi-blockvision.ts",
  "exp:features": "tsx src/exp_features_distribution.ts",
    "test": "vitest run --reporter=default",
    "ci:verify": "VERIFY_ALL_HARD_REPLAY=1 VERIFY_ALL_HARD_DETERMINISM=1 AUDIT_VERIFY_ON_APPEND=1 AUDIT_REFUSE_STALE=1 npm run verify:all && npm test",
    "check:verify:blockvision": "tsx src/tools/check-verify-blockvision.ts"
  },
  "dependencies": {
    "@metamask/delegation-toolkit": "^0.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-sha3": "^0.9.3",
    "viem": "^2.21.0",
    "@switchboard-xyz/on-demand": "^0.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
