{
  "name": "dca-autonomous-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
  "build": "tsc -p .",
  "dev": "tsx src/index.ts",
  "dev:api": "tsx watch src/index.ts",
  "start": "tsx src/index.ts",
  "serve:dist": "npm run build && node dist/index.js",
  "debug:start": "env | grep -E 'RPC_URL|ZERO_DEV|PIMLICO|DELEGATE|NO_API' || true; node -e 'console.log(\"[preflight] node version\", process.version)'; tsx src/index.ts",
  "api:start": "bash ./api-start.sh",
  "api:stop": "bash ./api-stop.sh",
  "dca:once": "tsx src/index.ts --once",
  "verify:audit": "tsx src/verify-audit.ts",
  "audit:migrate:dry": "tsx src/migrate-audit-chain.ts --dry",
  "audit:migrate": "tsx src/migrate-audit-chain.ts && npm run verify:audit",
  "replay:decision": "tsx src/replay-decision.ts",
  "verify:latest": "tsx src/verify-latest-decision.ts"
  },
  "dependencies": {
    "@metamask/delegation-toolkit": "^0.13.0",
  "cors": "^2.8.5",
    "dotenv": "^16.4.5",
  "express": "^4.19.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
  "ts-node": "^10.9.2",
  "tsx": "^4.19.1",
  "typescript": "^5.6.3",
  "@types/cors": "^2.8.17"
  }
}
