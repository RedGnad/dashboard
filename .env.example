RPC_URL="https://testnet-rpc.monad.xyz"
ZERO_DEV_BUNDLER_RPC="https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/10143"
ZERO_DEV_PAYMASTER_RPC="https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/10143?selfFunded=true"
DELEGATE_PRIVATE_KEY="0x..."
DCA_AMOUNT_USDC="1"
SLIPPAGE_BPS="100"
UNWRAP_TO_MON="true"
DELEGATOR_SMART_ACCOUNT="0x..."
SIGNED_DELEGATION_PATH="data/signedDelegation.json"
RPC_URL=https://testnet-rpc.monad.xyz
# Preferred: ZeroDev; provide full RPC URLs per chain id 10143
ZERO_DEV_BUNDLER_RPC=
ZERO_DEV_PAYMASTER_RPC=
# Fallback (optional): Pimlico
PIMLICO_BUNDLER_RPC=
PIMLICO_PAYMASTER_RPC=

# Agent signer (delegate)
DELEGATE_PRIVATE_KEY=0x...

# DCA config
DCA_AMOUNT_USDC=1
SLIPPAGE_BPS=100
UNWRAP_TO_MON=true

# --- Envio GraphQL (for Protocol Metrics panel) ---
# Local Hasura when running Envio HyperIndex locally (Option A)
ENVIO_GRAPHQL_URL=http://localhost:8080/v1/graphql
ENVIO_HASURA_ADMIN_SECRET=testing
# If using a hosted deployment with bearer token instead of admin secret:
# ENVIO_GRAPHQL_BEARER=your_token_here

# BlockVision API (for ABI retrieval on Monad testnet)
# Signup: https://dashboard.blockvision.org/overview
BLOCKVISION_API_KEY=
## Example (do not commit real keys)
# BLOCKVISION_API_KEY=33pisxQQsVe1DFiVSzA89UuLJyi
